<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="6dp">
 <LinearLayout android:id="@+id/widget_surface" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="14dp" android:background="@drawable/widget_day" android:clipToOutline="true">
  <ImageView android:id="@+id/widget_seal" android:layout_width="80dp" android:layout_height="56dp" android:src="@drawable/orbit_seal" android:contentDescription="@null" android:importantForAccessibility="no"/>
  <ImageView android:id="@+id/widget_photo" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scaleType="centerCrop" android:background="@drawable/widget_day" android:clipToOutline="true" android:visibility="gone" android:contentDescription="@null" android:importantForAccessibility="no"/>
  <TextView android:id="@+id/widget_title" style="@style/OrbitWidgetTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Orbit" android:textSize="17sp" android:textColor="#202431" android:maxLines="2" android:ellipsize="end"/>
  <TextView android:id="@+id/widget_detail" style="@style/OrbitWidgetText" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Open Orbit" android:textSize="12sp" android:textColor="#595F6F" android:maxLines="2" android:ellipsize="end" android:layout_marginTop="4dp"/>
  <TextView android:id="@+id/widget_updated" style="@style/OrbitWidgetText" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textSize="10sp" android:textColor="#595F6F" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="4dp"/>
 </LinearLayout>
</FrameLayout>
