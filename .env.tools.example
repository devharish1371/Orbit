# Supabase — human task #2; never paste secret values into chat
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_URL=

# Orbit internal — secret generation is local
ORBIT_FN_SECRET=
ORBIT_FN_BASE_URL=https://<project-ref>.supabase.co/functions/v1

# Accounts — passwords are prompted, never stored
USER_A_PHONE=+91XXXXXXXXXX
USER_A_NAME=
USER_B_PHONE=+91XXXXXXXXXX
USER_B_NAME=
AUTH_MODE=email-otp
USER_A_EMAIL=
USER_B_EMAIL=

# Email OTP delivery — use a free SMTP sender; never a normal Gmail password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Push — human task #3; Telegram is optional (#4)
FCM_SERVICE_ACCOUNT_B64=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
